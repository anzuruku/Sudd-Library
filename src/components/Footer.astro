---
import { SITE } from '../data/site';
const waReport = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Hi, I found a broken link on Sudd Library: ')}`;
const waContact = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Hi, I have a question about Sudd Library: ')}`;
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src="/jacob.jpg" alt="" width="28" height="28" class="footer-photo" loading="lazy" />
      <span class="footer-word">{SITE.org}</span>
    </div>
    <nav class="footer-links">
      <a href={waContact} target="_blank" rel="noopener" class="footer-links__primary">Contact</a>
      <a href={waReport} target="_blank" rel="noopener">Report a broken link</a>
      <a href="/disclaimer/">Disclaimer</a>
      <a href="/about/">About</a>
    </nav>
    <p class="footer-fine">
      Managed by <a href={SITE.builderUrl} target="_blank" rel="noopener">{SITE.builder}</a> · Open source (<a href={SITE.repoUrl} target="_blank" rel="noopener">GitHub</a>) · © {new Date().getFullYear()}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--anz-deep);
    margin-top: 48px;
  }
  .footer-inner {
    padding: 22px 18px 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .footer-photo {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(241, 245, 242, 0.25);
  }
  .footer-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.03em;
    color: rgba(241, 245, 242, 0.85);
  }
  .footer-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: rgba(241, 245, 242, 0.55);
  }
  .footer-links a:hover { color: var(--white); }
  .footer-links__primary {
    color: #7FE0AA;
    font-weight: 500;
  }
  .footer-links__primary:hover { color: #A3ECC4; }
  .footer-fine a {
    color: rgba(241, 245, 242, 0.45);
    text-decoration: underline;
  }
  .footer-fine a:hover { color: var(--white); }
  .footer-fine {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: rgba(241, 245, 242, 0.3);
    padding-top: 8px;
    margin: 0;
    border-top: 1px solid rgba(241, 245, 242, 0.1);
  }
</style>
